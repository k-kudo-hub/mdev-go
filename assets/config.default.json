{
  "search_dirs": ["~/projects", "~/works"],
  "search_depth": 1,
  "agent": {
    "command": "claude",
    "resume_args": "--resume"
  },
  "agents": {
    "claude": {
      "command": "claude",
      "resume_args": "--resume",
      "detection": "hooks"
    },
    "codex": {
      "command": "codex",
      "resume_args": "resume",
      "detection": "screen",
      "patterns": {
        "neutral": [],
        "blocked": [
          "^ *Would you like to run the following command\\? *$",
          "^ *Would you like to make the following edits\\? *$",
          "^ *Would you like to grant these permissions\\? *$",
          "^ *Press enter to confirm or esc to cancel *$"
        ],
        "working": ["\\([^)]*• [^)]* to interrupt\\)"]
      }
    }
  },
  "upload": {
    "enabled": false,
    "repo": "",
    "base_dir": "work-log",
    "branch": "main"
  },
  "update_check": {
    "enabled": true
  },
  "skip_task_name_input": false,
  "pricing": {
    "claude-opus-4-7": {
      "input": 5.0,
      "output": 25.0,
      "cache_write_5m": 6.25,
      "cache_write_1h": 10.0,
      "cache_hit": 0.5
    },
    "claude-opus-4-6": {
      "input": 5.0,
      "output": 25.0,
      "cache_write_5m": 6.25,
      "cache_write_1h": 10.0,
      "cache_hit": 0.5
    },
    "claude-opus-4-5": {
      "input": 5.0,
      "output": 25.0,
      "cache_write_5m": 6.25,
      "cache_write_1h": 10.0,
      "cache_hit": 0.5
    },
    "claude-sonnet-4-6": {
      "input": 3.0,
      "output": 15.0,
      "cache_write_5m": 3.75,
      "cache_write_1h": 6.0,
      "cache_hit": 0.3
    },
    "claude-sonnet-4-5": {
      "input": 3.0,
      "output": 15.0,
      "cache_write_5m": 3.75,
      "cache_write_1h": 6.0,
      "cache_hit": 0.3
    },
    "claude-haiku-4-5": {
