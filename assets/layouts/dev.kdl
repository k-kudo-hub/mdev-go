layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
        children
    }

    tab name="Dev" focus=true {
        pane split_direction="vertical" {
            pane {
                name "Agent"
                command "bash"
                args "-c" "${CONDUCTOR_HOME:-$HOME/.claude-conductor}/bin/mdev agent launch"
                size "50%"
            }
            pane split_direction="horizontal" size="50%" {
                pane {
                    name "LazyVim"
                    command "nvim"
                    size "50%"
                }
                pane {
                    name "lazygit"
                    command "lazygit"
                    size "50%"
                }
            }
        }
    }

    tab name="Git" {
        pane {
            name "lazygit"
            command "lazygit"
            start_suspended true
        }
    }

    tab name="Shell" {
        pane split_direction="vertical" {
            pane
            pane
        }
    }
}
